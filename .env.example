# Use the local API settings screen for separate provider/model choices and saved keys.
# Managed keys override legacy fallbacks; deletion disables the provider without editing API.txt.
# API.txt is ignored by Git. Put a raw Groq key there, or set GROQ_API_KEY locally.
# Never put credentials in frontend code, snapshots or project bundles.
# GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
TERM_AGENT_PDF_MODE=vision
# Keep 1 for offline use; change to 0 when explicitly ready for real model calls.
TERM_AGENT_OFFLINE=1
TERM_AGENT_MAX_CALLS=500
TERM_AGENT_CHUNK_CHARS=7000
# Discovery additionally limits block count, including very short labels.
TERM_AGENT_CHUNK_UNITS=8
TERM_AGENT_MAX_OUTPUT_TOKENS=4096
TERM_AGENT_LINK_BATCH_SIZE=8

# Other provider credentials may be supplied locally instead of saving through the UI:
# GOOGLE_API_KEY=your-key-here  (GEMINI_API_KEY is also accepted)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here
# DASHSCOPE_API_KEY=your-key-here  (Singapore endpoint)
# MOONSHOT_API_KEY=your-key-here  (international endpoint)
# Never commit the local .env.providers.json file or copy it into a project bundle.
